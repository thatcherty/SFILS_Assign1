{
  "collMod": "patron_types",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [ "patron_type_code", "patron_type" ],
      "properties": {
        "patron_type_code": {
          "bsonType": "int",
          "description": "must be a integer and is required"
        },
        "patron_type": {
          "bsonType": "string",
          "description": "must be a string  and is required"
        }
      }
    }
  }
}
