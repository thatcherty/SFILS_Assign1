@page "{id}"
@model SFILS.Pages.DetailsModel
@{
    ViewData["Title"] = "Patron Details";
}

<h1 class="mb-3">Patron Details</h1>

@if (Model.Patron is null)
{
    <div class="alert alert-warning">Patron not found.</div>
}
else
{
    <dl class="row">

        <dt class="col-sm-3">Mongo _id</dt>
        <dd class="col-sm-9">@Model.Patron._id.ToString()</dd>

        <dt class="col-sm-3">Patron ID</dt>
        <dd class="col-sm-9">@Model.Patron.Patron_Id</dd>

        <dt class="col-sm-3">Provided Email</dt>
        <dd class="col-sm-9">
            @if (Model.Patron.Provided_Email == 1)
            {
                <span>Yes</span>
            }
            else
            {
                <span>No</span>
            }
        </dd>

        <dt class="col-sm-3">Patron Type</dt>
        <dd class="col-sm-9">@Model.Patron.Patron_Type?.Patron_Type</dd>

        <dt class="col-sm-3">Age Range</dt>
        <dd class="col-sm-9">@Model.Patron.Age_Range?.Age_Range</dd>

        <dt class="col-sm-3">Home Library</dt>
        <dd class="col-sm-9">@Model.Patron.Home_Library?.Home_Library</dd>

        <dt class="col-sm-3">Notification Pref</dt>
        <dd class="col-sm-9">@Model.Patron.Notification_Pref?.Notif_Pref</dd>

        <dt class="col-sm-3">Within County</dt>
        <dd class="col-sm-9">
            @if (Model.Patron.Within_County == 1)
            {
                <span>Yes</span>
            }
            else
            {
                <span>No</span>
            }
        </dd>

        <dt class="col-sm-3">Year Registered</dt>
        <dd class="col-sm-9">@Model.Patron.Year_Reg</dd>

        <dt class="col-sm-3">Total Checkouts</dt>
        <dd class="col-sm-9">@Model.Patron.Total_Checkouts</dd>

        <dt class="col-sm-3">Total Renewals</dt>
        <dd class="col-sm-9">@Model.Patron.Total_Renewals</dd>

        <dt class="col-sm-3">Circulation Active Month</dt>
        <dd class="col-sm-9">@Model.Patron.Circ_Active_Mo</dd>

        <dt class="col-sm-3">Circulation Active Year</dt>
        <dd class="col-sm-9">@Model.Patron.Circ_Active_Yr</dd>

    </dl>

    <p class="mt-3">
        <a asp-page="./Index">Back to List</a>
    </p>
}
